{
    "config_version": "1.0",
    "model": {
        "metadata": {"name": "yolo26n-pose", "path": "yolo26n-pose.blob", "precision": "float16",
                     "source": "models/onnx/yolo26n-pose-640x480.onnx via Luxonis blob converter (OpenVINO 2022.1, 8 shaves, mean 0, scale 255, --reverse_input_channels)"},
        "inputs": [{"name": "images", "dtype": "uint8", "input_type": "image",
                    "shape": [1, 3, 640, 480], "layout": "NCHW"}],
        "outputs": [{"name": "output0", "dtype": "float32", "shape": [1, 56, 6300], "layout": "NCD"}],
        "heads": [{"name": null, "parser": "YOLOPose",
                   "metadata": {"classes": ["person"], "n_classes": 1, "n_keypoints": 17,
                                "conf_threshold": 0.5, "iou_threshold": 0.5}}]
    }
}
