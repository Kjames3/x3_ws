        </collision>
    </link>
    <!-- ============ 2D->3D tilting lidar mount (2026-08, "Prototype_Assembly") ============
         Replaces the old fixed 4ROS riser. A printed bottom plate + 4ROS mount
         adapter bolt to the chassis at the riser's old footprint; the lidar now
         rides in a carousel cradle that pitches forward/back in four 608RS
         bearings, driven by a LewanSoul LX-16A bus servo through a coupler.
         Sweeping the tilt while the 2-D scanner spins is what produces the 3-D
         point cloud.

         All geometry below is taken from cad/Prototype_Assembly.STEP (mm, SW 2024):
           - tilt axis is along the robot's Y (pitch), 153.0 mm above the mount
             base datum and 12.5 mm behind the lidar centerline
           - the lidar seat sits 22.0 mm radially out from that axis, so at
             tilt=0 the scan plane is the same horizontal plane as before
           - the STLs were exported "translated to positive space", so each
             visual/collision origin re-applies the part's own STEP origin
             offset; do not assume the meshes are centered.

         Placement datum. The new lidar is 11.8 mm rearward and 90 mm higher than
         the old one, applied to the old lidar's MEASURED pose, not to the value
         the URDF used to record.

         x: the old laser_joint x was measured on the robot 2026-08-08 as +0.055
         (NOT the -0.0115 this file once claimed, which recorded a '55 mm rear'
         shift that never happened). Method: spin in place through 5 full turns;
         if the offset is wrong by e the scan-to-map position traces a circle of
         radius |e|, linear in the unknowns and solvable by least squares. Result
         ex = +0.056 +/- 0.007 m statistical (8.2 sigma), ~+/-0.03 m systematic;
         ey = -0.011 m and NOT significant (1.6 sigma), which is correct since the
         unit is laterally centred and doubles as a control on the fit. True x lies
         in +0.045..+0.061, central estimate 0.055. This brackets the stock X3
         value (+0.0435), further evidence the rear-shift edit was wrong; the
         measurement was chosen over the stock figure because this chassis is an
         X3 PLUS running the X3 model, so no stock number can be assumed.
         0.055 - 0.0118 = 0.0432 is therefore the new scan x.

         A wrong x here is a lever arm: it swings the scan about the wrong point as
         the robot turns, and slam_toolbox bakes the same error into any map it
         builds. REMAP after changing it.

         z: the X3 Plus upper plate top is z=0.062 in base_link. The mount's
         bottom datum is therefore placed at z=0.062 so it rests on the plate
         instead of floating above it. -->
    <link name="lidar_mount_link">
        <!-- adapter + bottom plate + 4x 608RS + servo bracket + LX-16A.
             Printed parts at ~0.55 g/cm^3 effective (PLA, ~45% fill); bearings
             12 g each and the LX-16A 52 g from spec. Mass/inertia integrated
             over the actual meshes, expressed about the composite COM. -->
        <inertial>
            <origin xyz="-0.01270 -0.02147 0.10269" rpy="0 0 0"/>
            <mass value="0.2387"/>
            <inertia ixx="1.1115E-03" ixy="1.0498E-06" ixz="-4.3702E-06"
                     iyy="7.1579E-04" iyz="1.6225E-04" izz="4.7960E-04"/>
        </inertial>

        <!-- 4ROS mount adapter: bolts to the chassis lidar pad on its lower
             face (same 21 mm / 3-hole circle the lidar itself used) -->
        <visual>
            <origin xyz="0.035000 0.042000 0.000000" rpy="1.5707963 0 -1.5707963"/>
            <geometry>
                <mesh filename="package://yahboomcar_description/meshes/4ROS_mount_adapterV2.STL" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="">
                <color rgba="0.3 0.3 0.3 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0.035000 0.042000 0.000000" rpy="1.5707963 0 -1.5707963"/>
            <geometry>
                <mesh filename="package://yahboomcar_description/meshes/4ROS_mount_adapterV2.STL" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>

        <!-- bottom plate: the 156 mm upright that carries the bearing bores -->
        <visual>
            <origin xyz="0.035000 0.042040 0.012000" rpy="1.5707963 0 -1.5707963"/>
            <geometry>
                <mesh filename="package://yahboomcar_description/meshes/bottomPlate.STL" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="">
                <color rgba="0.3 0.3 0.3 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0.035000 0.042040 0.012000" rpy="1.5707963 0 -1.5707963"/>
            <geometry>
                <mesh filename="package://yahboomcar_description/meshes/bottomPlate.STL" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>

        <!-- LX-16A servo bracket -->
        <visual>
            <origin xyz="0.002850 -0.039300 0.087875" rpy="1.5707963 0 -1.5707963"/>
            <geometry>
                <mesh filename="package://yahboomcar_description/meshes/lx16_mountV2.STL" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="">
                <color rgba="0.3 0.3 0.3 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0.002850 -0.039300 0.087875" rpy="1.5707963 0 -1.5707963"/>
            <geometry>
                <mesh filename="package://yahboomcar_description/meshes/lx16_mountV2.STL" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>

        <!-- LewanSoul LX-16A body, on the robot's right (-Y) side.
             STEP only, no STL in the zip, so it is drawn as its 24.7 x 45.2 x
             38.1 mm bounding box. -->
        <visual>
            <origin xyz="-0.012500 -0.075150 0.140650" rpy="0 0 0"/>
            <geometry>
                <box size="0.0247 0.0381 0.0452"/>
            </geometry>
            <material name="">
                <color rgba="0.1 0.1 0.1 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="-0.012500 -0.075150 0.140650" rpy="0 0 0"/>
            <geometry>
                <box size="0.0247 0.0381 0.0452"/>
            </geometry>
        </collision>

        <!-- 4x 608RS bearings on the tilt axis at y = +38.4, +27.8, -27.8, -38.4 mm.
             Visual only; the pitch term in each rpy is that bearing's own
             clocking in the CAD and has no kinematic meaning. -->
        <visual>
            <origin xyz="0.003056 0.034900 0.153076" rpy="1.5707963 0.7902475 -3.1415927"/>
            <geometry>
                <mesh filename="package://yahboomcar_description/meshes/608RS.STL" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="">
                <color rgba="0.6 0.6 0.6 1"/>
            </material>
        </visual>
        <visual>
            <origin xyz="-0.027746 0.031300 0.149906" rpy="1.5707963 0.5851783 0"/>
            <geometry>
                <mesh filename="package://yahboomcar_description/meshes/608RS.STL" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="">
                <color rgba="0.6 0.6 0.6 1"/>
            </material>
        </visual>
        <visual>
            <origin xyz="-0.023842 -0.024300 0.142353" rpy="1.5707963 0.0315727 0"/>
            <geometry>
                <mesh filename="package://yahboomcar_description/meshes/608RS.STL" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="">
                <color rgba="0.6 0.6 0.6 1"/>
            </material>
        </visual>
        <visual>
            <origin xyz="-0.026141 -0.034900 0.145522" rpy="1.5707963 0.2839484 0"/>
            <geometry>
                <mesh filename="package://yahboomcar_description/meshes/608RS.STL" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="">
                <color rgba="0.6 0.6 0.6 1"/>
            </material>
        </visual>
    </link>
    <joint name="lidar_mount_joint" type="fixed">
        <origin xyz="0.0557 5.25826986680105E-05 0.062" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="lidar_mount_link"/>
    </joint>

    <!-- Rotating cradle: carousel + shaft coupler. -->
    <link name="lidar_tilt_link">
        <inertial>
            <origin xyz="-0.00006 -0.01407 0.01659" rpy="0 0 0"/>
            <mass value="0.0224"/>
            <inertia ixx="1.729E-05" ixy="4.846E-08" ixz="-1.519E-08"
                     iyy="6.351E-06" iyz="-6.114E-07" izz="2.068E-05"/>
        </inertial>
        <visual>
            <origin xyz="0.030000 0.045049 -0.010000" rpy="1.5707963 0 -1.5707963"/>
            <geometry>
                <mesh filename="package://yahboomcar_description/meshes/4ros_carouselV3.STL" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="">
                <color rgba="0.3 0.3 0.3 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0.030000 0.045049 -0.010000" rpy="1.5707963 0 -1.5707963"/>
            <geometry>
                <mesh filename="package://yahboomcar_description/meshes/4ros_carouselV3.STL" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
        <visual>
            <origin xyz="0.004714 -0.024000 0.004714" rpy="-1.5707963 0 -3.1415927"/>
            <geometry>
                <mesh filename="package://yahboomcar_description/meshes/couplerV4.STL" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="">
                <color rgba="0.5 0.5 0.5 1"/>
            </material>
        </visual>
    </link>
    <!-- Pitch joint. axis +Y, so a POSITIVE command noses the lidar DOWN
         (scan plane sweeps toward the floor in front of the robot) and a
         negative command noses it up. Limits are the LX-16A's own 0-240 deg
         travel (+/-120 deg about center); tighten them to the cradle's real
         mechanical sweep once it has been measured. effort/velocity are the
         servo's 17 kg-cm stall torque and 0.16 s/60 deg no-load speed.

         NOTE: nothing publishes this joint yet. joint_state_publisher (already
         in x3_bringup.launch.py / x3_slam.launch.py) will hold it at 0, which
         reproduces the old fixed-lidar TF exactly. Feed the real servo angle
         into /joint_states before trusting any assembled 3-D cloud. -->
    <joint name="lidar_tilt_joint" type="revolute">
        <origin xyz="-0.0125 0 0.153" rpy="0 0 0"/>
        <parent link="lidar_mount_link"/>
        <child link="lidar_tilt_link"/>
        <axis xyz="0 1 0"/>
        <limit lower="-2.0944" upper="2.0944" effort="1.6" velocity="6.5"/>
    </joint>

    <joint name="laser_joint" type="fixed">
        <!-- 22.0 mm out from the tilt axis onto the carousel's lidar seat.
             The carousel reuses the adapter's 3-hole 21 mm bolt circle in the
             same clocking, so the lidar keeps its previous 180 deg yaw. -->
        <origin xyz="0 0 0.022" rpy="0 0 3.14159265"/>
        <parent link="lidar_tilt_link"/>
        <child link="laser_link"/>
    </joint>

    <link name="camera_link">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0"/>
            <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://yahboomcar_description/meshes/camera_link.STL"/>
            </geometry>
            <material name="">
                <color rgba="0.7 0.7 0.7 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://yahboomcar_description/meshes/camera_link.STL"/>
            </geometry>
        </collision>
    </link>
    <joint name="camera_joint" type="fixed">
        <!-- X3 Plus chassis front is x=0.145400 in the vendor mesh. The Astra
             mesh's front face is x=+0.020085 from camera_link, so placing the
             joint at x=0.107315 leaves the measured 18 mm setback while keeping
             the existing, physically correct camera height unchanged. -->
        <origin xyz="0.107315 1.7948E-05 0.03755" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="camera_link"/>
    </joint>

    <!-- ==================== OAK-D Lite (2026) ====================
         Luxonis OAK-D Lite stereo depth + RGB camera. The optical centre was
         physically measured 0.210 m above the floor. With the X3 Plus
         base_footprint -> base_link height of 0.0815 m, its base_link-relative
         z is therefore 0.1285 m. It is centered laterally and directly above the
         Astra camera; its mount is level. Frame names follow the depthai_ros
         (depthai_ros_driver) convention with camera name "oak" so published
         image/pointcloud TF (oak_rgb_camera_optical_frame, etc.) resolves
         against these static frames. Set the driver's `camera.i_tf_prefix`
         / publish_tf_from_calibration=false so it does NOT re-publish these.
         Stereo baseline 75 mm: left mono +Y, right mono -Y from center. -->
    <link name="oak-d-base-frame">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.0611"/>
            <inertia ixx="4.3E-05" ixy="0" ixz="0"
                     iyy="4.5E-06" iyz="0" izz="4.5E-05"/>
        </inertial>
        <visual>
            <!-- OAK-D Lite body approx 91 (Y) x 28 (X) x 17.5 (Z) mm -->
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.028 0.091 0.0175"/>
            </geometry>
            <material name="">
                <color rgba="0.15 0.15 0.15 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.028 0.091 0.0175"/>
            </geometry>
        </collision>
    </link>
    <joint name="oak_center_joint" type="fixed">
        <!-- The OAK-D Lite is centered laterally and mounted directly above the
             Astra camera. Keep its verified height/orientation and align its
             fore/aft center with camera_link. -->
        <origin xyz="0.107315 1.7948E-05 0.1285" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="oak-d-base-frame"/>
    </joint>

    <!-- RGB camera (center) -->
    <link name="oak_rgb_camera_frame"/>
    <joint name="oak_rgb_camera_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="oak-d-base-frame"/>
        <child link="oak_rgb_camera_frame"/>
    </joint>
    <link name="oak_rgb_camera_optical_frame"/>
    <joint name="oak_rgb_camera_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
        <parent link="oak_rgb_camera_frame"/>
        <child link="oak_rgb_camera_optical_frame"/>
    </joint>

    <!-- Left mono camera (+Y, robot left) -->
    <link name="oak_left_camera_frame"/>
    <joint name="oak_left_camera_joint" type="fixed">
        <origin xyz="0 0.0375 0" rpy="0 0 0"/>
        <parent link="oak-d-base-frame"/>
        <child link="oak_left_camera_frame"/>
    </joint>
    <link name="oak_left_camera_optical_frame"/>
    <joint name="oak_left_camera_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
        <parent link="oak_left_camera_frame"/>
        <child link="oak_left_camera_optical_frame"/>
    </joint>

    <!-- Right mono camera (-Y, robot right) -->
    <link name="oak_right_camera_frame"/>
    <joint name="oak_right_camera_joint" type="fixed">
        <origin xyz="0 -0.0375 0" rpy="0 0 0"/>
        <parent link="oak-d-base-frame"/>
        <child link="oak_right_camera_frame"/>
    </joint>
    <link name="oak_right_camera_optical_frame"/>
    <joint name="oak_right_camera_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
        <parent link="oak_right_camera_frame"/>
        <child link="oak_right_camera_optical_frame"/>
    </joint>

    <!-- On-board IMU -->
    <link name="oak_imu_frame"/>
    <joint name="oak_imu_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <parent link="oak-d-base-frame"/>
        <child link="oak_imu_frame"/>
    </joint>

    <!-- ============ Dual VL53L5CX front ToF arrays (2026-09-19) ============
         Source: stls/VL53LCX_mount.STEP. Upper adapter 15 deg, lower 40 deg.
         Meshes are tessellated in CAD part frames, METRES (no 0.001 scale).
         Mount CAD axes: +X robot-left, +Y up, +Z forward.
         Starting attachment uses the old bracket's height/lateral origin.
         Rear mating face moved from CAD z=-24.5 to -21.5 mm, so mount x
         shifts back 3 mm to preserve that face's chassis position.
         Refine ONLY tof_mount_joint for whole-assembly placement in RViz.
         Sensor/adapter relative placements come from the STEP assembly.
         Sensing origin uses the existing package-face point in board CAD:
         (0, 2.45, -1.97) mm. Re-measure installed poses before perception use.
         These are fixed adapter settings, not actuated joints.
         Legacy tof_link aliases the upper sensor; dual Teensy ingestion and
         downstream geometry configuration still require a separate update. -->
    <link name="tof_mount_link">
        <visual><origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><mesh filename="package://yahboomcar_description/meshes/tof_dual_bracket.stl"/></geometry><material name=""><color rgba="0.75 0.75 0.78 1"/></material>
        </visual>
        <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://yahboomcar_description/meshes/tof_dual_bracket.stl"/></geometry></collision>
        <visual><origin xyz="0.000000000 0.114000000 0.003500000" rpy="0.000000000 -0.000000000 0.000000000"/>
            <geometry><mesh filename="package://yahboomcar_description/meshes/tof_adapter_15.stl"/></geometry><material name=""><color rgba="0.75 0.75 0.78 1"/></material>
        </visual>
        <collision><origin xyz="0.000000000 0.114000000 0.003500000" rpy="0.000000000 -0.000000000 0.000000000"/><geometry><mesh filename="package://yahboomcar_description/meshes/tof_adapter_15.stl"/></geometry></collision>
        <visual><origin xyz="0.000000000 0.020000000 0.003500000" rpy="0.000000000 -0.000000000 0.000000000"/>
            <geometry><mesh filename="package://yahboomcar_description/meshes/tof_adapter_40.stl"/></geometry><material name=""><color rgba="0.75 0.75 0.78 1"/></material>
        </visual>
        <collision><origin xyz="0.000000000 0.020000000 0.003500000" rpy="0.000000000 -0.000000000 0.000000000"/><geometry><mesh filename="package://yahboomcar_description/meshes/tof_adapter_40.stl"/></geometry></collision>
    </link>
    <joint name="tof_mount_joint" type="fixed">
        <parent link="base_link"/><child link="tof_mount_link"/>
        <origin xyz="0.1450 0.0 -0.030549" rpy="1.570796326795 0 1.570796326795"/>
    </joint>
    <link name="tof_upper_board_link">
        <visual><origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><mesh filename="package://yahboomcar_description/meshes/tof_breakout.stl"/></geometry><material name=""><color rgba="0.05 0.35 0.12 1"/></material>
        </visual>
        <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://yahboomcar_description/meshes/tof_breakout.stl"/></geometry></collision>
    </link>
    <joint name="tof_upper_board_joint" type="fixed">
        <parent link="tof_mount_link"/><child link="tof_upper_board_link"/>
        <origin xyz="-0.000100000 0.113745168 0.016700834" rpy="-2.879793264 -0.000000000 0.000000000"/>
    </joint>
    <link name="tof_upper_link"/>
    <joint name="tof_upper_joint" type="fixed">
        <parent link="tof_mount_link"/><child link="tof_upper_link"/>
        <origin xyz="-0.000100000 0.110868776 0.017969601" rpy="0.000000000 -1.308996939 -1.570796327"/>
    </joint>
    <link name="tof_upper_optical_frame"/>
    <joint name="tof_upper_optical_joint" type="fixed">
        <parent link="tof_upper_link"/><child link="tof_upper_optical_frame"/>
        <origin xyz="0 0 0" rpy="-1.570796326795 0 -1.570796326795"/>
    </joint>
    <link name="tof_lower_board_link">
        <visual><origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><mesh filename="package://yahboomcar_description/meshes/tof_breakout.stl"/></geometry><material name=""><color rgba="0.05 0.35 0.12 1"/></material>
        </visual>
        <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://yahboomcar_description/meshes/tof_breakout.stl"/></geometry></collision>
    </link>
    <joint name="tof_lower_board_joint" type="fixed">
        <parent link="tof_mount_link"/><child link="tof_lower_board_link"/>
        <origin xyz="-0.000100000 0.018035352 0.019528620" rpy="-2.443460930 -0.000000000 -0.000000000"/>
    </joint>
    <link name="tof_lower_link"/>
    <joint name="tof_lower_joint" type="fixed">
        <parent link="tof_mount_link"/><child link="tof_lower_link"/>
        <origin xyz="-0.000100000 0.014892252 0.019462898" rpy="0.000000000 -0.872664626 -1.570796327"/>
    </joint>
    <link name="tof_lower_optical_frame"/>
    <joint name="tof_lower_optical_joint" type="fixed">
        <parent link="tof_lower_link"/><child link="tof_lower_optical_frame"/>
        <origin xyz="0 0 0" rpy="-1.570796326795 0 -1.570796326795"/>
    </joint>
    <link name="tof_link"/>
    <joint name="tof_joint" type="fixed">
        <parent link="tof_upper_link"/><child link="tof_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <link name="tof_optical_frame"/>
    <joint name="tof_optical_joint" type="fixed">
        <parent link="tof_link"/><child link="tof_optical_frame"/>
        <origin xyz="0 0 0" rpy="-1.570796326795 0 -1.570796326795"/>
    </joint>
    <!-- ============ PAA5100JE optical flow sensor (2026-09-16) ============
         Downward-looking flow sensor that sits in a cut-out of a modified X3
         Plus bottom plate, held by a printed mount on top of the plate.
         Geometry from stls/paa5100je_assembly3.STEP, whose placements are all
         relative to the plate, so everything below the plate joint is exact
         CAD: mount at plate (-1, 14, 27.5) mm, sensor at (-0.5, 4, 21) mm
         flipped 180 deg about X. The lens face ends up 1 mm below the plate
         underside, i.e. ~26.5 mm above the floor with base_joint 0.0815.

         paa5100je_plate_link is the plate's CAD frame: +X across the robot,
         +Y up (y=0 is the underside), +Z along the robot's +X. Its joint puts
         the underside on the chassis bottom (base_link z=-0.054); the fore/aft
         x and which end faces forward are NOT verified against the robot.
         The plate and mount STLs were converted from STEP in their part
         frames (metres); the sensor STL is the SolidWorks export (mm,
         translated into positive space, undone by its visual origin). -->
    <link name="paa5100je_plate_link">
        <inertial>
            <origin xyz="0 0.005 0" rpy="0 0 0"/>
            <mass value="0.150"/>
            <inertia ixx="5.5E-04" ixy="0" ixz="0" iyy="8.8E-04" iyz="0" izz="3.3E-04"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://yahboomcar_description/meshes/X3plus_bottom_plate_modified.STL"/>
            </geometry>
            <material name="">
                <color rgba="0.20 0.20 0.22 1"/>
            </material>
        </visual>
        <visual>
            <origin xyz="-0.001 0.014 0.0275" rpy="1.5707963 0 0"/>
            <geometry>
                <mesh filename="package://yahboomcar_description/meshes/paa5100je_left_centered_mount.STL"/>
            </geometry>
            <material name="">
                <color rgba="0.75 0.75 0.78 1"/>
            </material>
        </visual>
        <visual>
            <origin xyz="-0.0125 0.004 0.033" rpy="3.1415927 0 0"/>
            <geometry>
                <mesh filename="package://yahboomcar_description/meshes/PAA5100JE_sensor.STL" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="">
                <color rgba="0.55 0.05 0.05 1"/>
            </material>
        </visual>
    </link>
    <joint name="paa5100je_plate_joint" type="fixed">
        <parent link="base_link"/>
        <child link="paa5100je_plate_link"/>
        <origin xyz="-0.0344 0.0 -0.054" rpy="1.5707963 0 1.5707963"/>
    </joint>

    <!-- Sensing frame at the centre of the lens face, axes aligned with
         base_link (+X forward, +Z up; the lens looks -Z). Its z in
         base_footprint is the sensor's height above the floor. -->
    <link name="paa5100je_link"/>
    <joint name="paa5100je_joint" type="fixed">
        <parent link="paa5100je_plate_link"/>
        <child link="paa5100je_link"/>
        <origin xyz="-0.0005 -0.001 0.021" rpy="-1.5707963 -1.5707963 0"/>
    </joint>
</robot>
