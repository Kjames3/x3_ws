<robot name="yahboomcar">
    <link name="base_footprint"/>
    <link name="imu_link"/>
    <!-- X3 Plus chassis geometry from Yahboom's ROSMASTER-X3Plus vendor model.
         The physical robot is an X3 Plus, not the smaller X3 previously shown
         here. Project-specific lidar and OAK-D assemblies remain separate links
         below so their measured transforms can be calibrated independently. -->
    <link name="base_link">
        <inertial>
            <origin xyz="-0.0304416859098744 4.23384368655101E-05 0.0448234503408059" rpy="0 0 0"/>
            <mass value="1.0754239466482"/>
            <inertia
                    ixx="0.0208831789264125"
                    ixy="2.4618093127858E-06"
                    ixz="0.00616019290028669"
                    iyy="0.0265621377486244"
                    iyz="-1.10079499865282E-06"
                    izz="0.0129535610833954"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://yahboomcar_description/meshes/X3plus/visual/base_link.STL"/>
            </geometry>
            <material name="">
                <color rgba="0 0.7 0 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://yahboomcar_description/meshes/X3plus/collision/base_link.STL"/>
            </geometry>
        </collision>
    </link>
    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0.0 0.0 0.0815" rpy="0 0 0"/>
    </joint>
    <joint name="base_imu" type="fixed">
        <parent link="base_link"/>
        <child link="imu_link"/>
        <origin xyz="-0.06 0.01 0.01" rpy="0 3.1415 1.5707"/>
    </joint>

    <!-- ICM-42688-P (i2c-7 @ 0x68), the 200 Hz replacement for the MPU9250.
         It sits 3 cm behind the chassis centre directly on the X3 Plus upper
         plate, whose top surface is z=0.062 m in base_link.

         ROTATION IS DELIBERATELY IDENTITY. The physical chip sits at a +90 deg
         yaw (gravity measured on sensor Z; nose-up drove sensor Y negative;
         yaw-left gave sensor Z +105.9 deg), but icm42688_node ALREADY applies
         that remap in software (ros_x=-sensor_y, ros_y=+sensor_x,
         ros_z=+sensor_z) because imu_filter_madgwick does not consult TF and
         would otherwise emit an orientation in the rotated frame. Putting
         rpy="0 0 1.5708" here as well would apply the rotation TWICE. -->
    <link name="icm_imu_link"/>
    <joint name="base_icm_imu" type="fixed">
        <parent link="base_link"/>
        <child link="icm_imu_link"/>
        <origin xyz="-0.03 0 0.062" rpy="0 0 0"/>
    </joint>

    <!-- 12 V battery on the X3 Plus upper plate. Dimensions were physically
         measured as 61 mm fore/aft (X), 114 mm across (Y), and 75 mm tall.
         battery_link is the center of its bottom face, 61 mm behind the ICM. -->
    <link name="battery_link">
        <visual>
            <origin xyz="0 0 0.0375" rpy="0 0 0"/>
            <geometry>
                <box size="0.061 0.114 0.075"/>
            </geometry>
            <material name="battery_black">
                <color rgba="0.08 0.08 0.08 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0.0375" rpy="0 0 0"/>
            <geometry>
                <box size="0.061 0.114 0.075"/>
            </geometry>
        </collision>
    </link>
    <joint name="battery_joint" type="fixed">
        <parent link="base_link"/>
        <child link="battery_link"/>
        <origin xyz="-0.091 0 0.062" rpy="0 0 0"/>
    </joint>

