<?xml version="1.0" encoding="utf-8"?>
<robot name="yahboomcar" xmlns:xacro="http://wiki.ros.org/xacro">
    <material name="Green">
        <color rgba="0 0.7 0 1"/>
    </material>
    <material name="White">
        <color rgba="0.7 0.7 0.7 1"/>
    </material>
    <xacro:property name="ns" value="$(arg ns)"/>
    <link name="${ns}/base_footprint"/>
    <link name="${ns}/imu_link"/>
    <!-- common link-->
    <xacro:macro name="common_link" params="name material path *origin mesh_suffix:=''">
        <link name="${ns}/${name}">
            <visual>
                <geometry>
                    <mesh filename="package://yahboomcar_description/meshes/${path}/${name}${mesh_suffix}.STL"/>
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <material name="${material}"/>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://yahboomcar_description/meshes/${path}/${name}${mesh_suffix}.STL"/>
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </collision>
            <xacro:insert_block name="origin"/>
        </link>
    </xacro:macro>
    <!-- continuous joint-->
    <xacro:macro name="continuous_joint" params="name parent child xyz rpy axis">
        <joint name="${ns}/${name}" type="continuous">
            <parent link="${ns}/${parent}"/>
            <child link="${ns}/${child}"/>
            <origin xyz="${xyz}" rpy="${rpy}"/>
            <axis xyz="${axis}"/>
            <limit lower="${-pi}" upper="${pi}" effort="100" velocity="1"/>
        </joint>
    </xacro:macro>
    <!-- fixed joint-->
    <xacro:macro name="fixed_joint" params="name parent child xyz rpy">
        <joint name="${ns}/${name}" type="fixed">
            <parent link="${ns}/${parent}"/>
            <child link="${ns}/${child}"/>
            <origin xyz="${xyz}" rpy="${rpy}"/>
        </joint>
    </xacro:macro>
    <xacro:common_link name="base_link" material="Green" path="mecanum" mesh_suffix="_X3">
        <inertial>
            <origin xyz="0.00498197982182523 5.70233829969297E-05 -0.0121008098068578" rpy="0 0 0"/>
            <mass value="0.486218814966626"/>
            <inertia
                    ixx="0.00196277727666921"
                    ixy="2.50447049446755E-07"
                    ixz="0.000140534767811098"
                    iyy="0.00457256033711368"
                    iyz="2.68618064993882E-07"
                    izz="0.00493927269870476"/>
        </inertial>
    </xacro:common_link>
    <xacro:fixed_joint name="base_joint" parent="base_footprint" child="base_link" xyz="0.0 0.0 0.0815" rpy="0 0 0"/>
    <xacro:fixed_joint name="base_imu" parent="base_link" child="imu_link" xyz="-0.06 0.01 0.01" rpy="0 3.1415 1.5707"/>
    <xacro:common_link name="front_right_wheel" material="White" path="mecanum" mesh_suffix="_X3">
        <inertial>
            <origin xyz="1.9051E-06 -2.3183E-07 -0.00064079" rpy="0 0 0"/>
            <mass value="0.051532"/>
            <inertia ixx="1.4595E-05" ixy="-4.3975E-10" ixz="4.415E-10"
                     iyy="1.4594E-05" iyz="-1.7476E-09" izz="2.4264E-05"/>
        </inertial>
    </xacro:common_link>
    <xacro:continuous_joint name="front_right_joint" parent="base_link" child="front_right_wheel"
                      xyz="0.08 -0.0845 -0.0389" rpy="-${pi/2} 0 ${pi}" axis="0 0 1"/>
    <xacro:common_link name="front_left_wheel" material="White" path="mecanum" mesh_suffix="_X3">
        <inertial>
            <origin xyz="2.3728E-06 -9.4228E-07 0.00064068" rpy="0 0 0"/>
            <mass value="0.051543"/>
            <inertia ixx="1.4597E-05" ixy="-4.7945E-10" ixz="-2.4786E-10"
                     iyy="1.4598E-05" iyz="1.7972E-09" izz="2.4267E-05"/>
        </inertial>
    </xacro:common_link>
    <xacro:continuous_joint name="front_left_joint" parent="base_link" child="front_left_wheel"
                      xyz="0.08 0.084492 -0.0389" rpy="${pi/2} 0 0" axis="0 0 1"/>
    <xacro:common_link name="back_right_wheel" material="White" path="mecanum" mesh_suffix="_X3">
        <inertial>
            <origin xyz="-1.75924169923403E-06 1.28388821071107E-06 -0.000590549296238266" rpy="0 0 0"/>
            <mass value="0.051540174053366"/>
            <inertia ixx="1.45974152250002E-05" ixy="1.94850559178397E-10" ixz="-1.61846387282284E-09"
                     iyy="1.4596501955693E-05" iyz="-6.27904057423818E-10" izz="2.42663091380451E-05"/>
        </inertial>
    </xacro:common_link>
    <xacro:continuous_joint name="back_right_joint" parent="base_link" child="back_right_wheel"
                      xyz="-0.08 -0.0845 -0.03946" rpy="-${pi/2} 0 ${pi}" axis="0 0 1"/>
    <xacro:common_link name="back_left_wheel" material="White" path="mecanum" mesh_suffix="_X3">
        <inertial>
            <origin xyz="-4.01213085227115E-07 2.04910264598596E-06 0.000590775697051377" rpy="0 0 0"/>
            <mass value="0.0515309299357028"/>
            <inertia ixx="1.45942986129926E-05" ixy="-3.19787215398093E-10" ixz="1.74943062058915E-09"
                     iyy="1.45948727598913E-05" iyz="1.61769812110049E-10" izz="2.4263683888153E-05"/>
        </inertial>
    </xacro:common_link>
    <xacro:continuous_joint name="back_left_joint" parent="base_link" child="back_left_wheel"
                      xyz="-0.08 0.084492 -0.03954" rpy="${pi/2} 0 0" axis="0 0 1"/>
    <xacro:common_link name="laser_link" material="White" path="sensor">
        <inertial>
            <origin xyz="-0.0176558922685589 0.000671805271544437 0.0219302095894866" rpy="0 0 0"/>
            <mass value="0.0483909504209895"/>
            <inertia ixx="1.58456966399128E-05" ixy="-4.23913983850005E-07" ixz="-2.09597897904374E-07"
                     iyy="3.89262522903605E-05" iyz="3.24809725932687E-07" izz="4.86230801106223E-05"/>
        </inertial>
    </xacro:common_link>
    <!-- ============ 2D->3D tilting lidar mount (2026-08) ============
         Bottom plate + 4ROS adapter bolt to the chassis; the lidar rides in a
         carousel cradle pitching in four 608RS bearings, driven by an LX-16A
         bus servo. Geometry from yahboomcar_description/cad/Prototype_Assembly.STEP.
         See yahboomcar_X3.urdf for the full derivation notes. -->
    <link name="${ns}/lidar_mount_link">
        <inertial>
            <origin xyz="-0.01270 -0.02147 0.10269" rpy="0 0 0"/>
            <mass value="0.2387"/>
            <inertia ixx="1.1115E-03" ixy="1.0498E-06" ixz="-4.3702E-06"
                     iyy="7.1579E-04" iyz="1.6225E-04" izz="4.7960E-04"/>
        </inertial>
        <xacro:macro name="mount_part" params="file xyz rpy">
            <visual>
                <origin xyz="${xyz}" rpy="${rpy}"/>
                <geometry>
                    <mesh filename="package://yahboomcar_description/meshes/${file}" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="White"/>
            </visual>
            <collision>
                <origin xyz="${xyz}" rpy="${rpy}"/>
                <geometry>
                    <mesh filename="package://yahboomcar_description/meshes/${file}" scale="0.001 0.001 0.001"/>
                </geometry>
            </collision>
        </xacro:macro>
        <xacro:mount_part file="4ROS_mount_adapterV2.STL" xyz="0.035000 0.042000 0.000000" rpy="1.5707963 0 -1.5707963"/>
        <xacro:mount_part file="bottomPlate.STL"          xyz="0.035000 0.042040 0.012000" rpy="1.5707963 0 -1.5707963"/>
        <xacro:mount_part file="lx16_mountV2.STL"         xyz="0.002850 -0.039300 0.087875" rpy="1.5707963 0 -1.5707963"/>
        <!-- LX-16A body: STEP only, drawn as its bounding box -->
        <visual>
            <origin xyz="-0.012500 -0.075150 0.140650" rpy="0 0 0"/>
            <geometry>
                <box size="0.0247 0.0381 0.0452"/>
            </geometry>
            <material name="White"/>
        </visual>
        <collision>
            <origin xyz="-0.012500 -0.075150 0.140650" rpy="0 0 0"/>
            <geometry>
                <box size="0.0247 0.0381 0.0452"/>
            </geometry>
        </collision>
        <!-- 4x 608RS on the tilt axis; the pitch term is CAD clocking only -->
        <xacro:macro name="mount_bearing" params="xyz rpy">
            <visual>
                <origin xyz="${xyz}" rpy="${rpy}"/>
                <geometry>
                    <mesh filename="package://yahboomcar_description/meshes/608RS.STL" scale="0.001 0.001 0.001"/>
                </geometry>
                <material name="White"/>
            </visual>
        </xacro:macro>
        <xacro:mount_bearing xyz="0.003056 0.034900 0.153076"  rpy="1.5707963 0.7902475 -3.1415927"/>
        <xacro:mount_bearing xyz="-0.027746 0.031300 0.149906" rpy="1.5707963 0.5851783 0"/>
        <xacro:mount_bearing xyz="-0.023842 -0.024300 0.142353" rpy="1.5707963 0.0315727 0"/>
        <xacro:mount_bearing xyz="-0.026141 -0.034900 0.145522" rpy="1.5707963 0.2839484 0"/>
    </link>
    <xacro:fixed_joint name="lidar_mount_joint" parent="base_link" child="lidar_mount_link" xyz="0.0557 5.25826986680105E-05 0.0885" rpy="0 0 0"/>

    <!-- Rotating cradle: carousel + shaft coupler -->
    <link name="${ns}/lidar_tilt_link">
        <inertial>
            <origin xyz="-0.00006 -0.01407 0.01659" rpy="0 0 0"/>
            <mass value="0.0224"/>
            <inertia ixx="1.729E-05" ixy="4.846E-08" ixz="-1.519E-08"
                     iyy="6.351E-06" iyz="-6.114E-07" izz="2.068E-05"/>
        </inertial>
        <xacro:mount_part file="4ros_carouselV3.STL" xyz="0.030000 0.045049 -0.010000" rpy="1.5707963 0 -1.5707963"/>
        <visual>
            <origin xyz="0.004714 -0.024000 0.004714" rpy="-1.5707963 0 -3.1415927"/>
            <geometry>
                <mesh filename="package://yahboomcar_description/meshes/couplerV4.STL" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="White"/>
        </visual>
    </link>
    <!-- axis +Y: positive noses the lidar DOWN. Limits are the LX-16A's own
         +/-120 deg travel; nothing publishes this joint yet, so
         joint_state_publisher holds it at 0 (= the old fixed-lidar TF). -->
    <joint name="${ns}/lidar_tilt_joint" type="revolute">
        <parent link="${ns}/lidar_mount_link"/>
        <child link="${ns}/lidar_tilt_link"/>
        <origin xyz="-0.0125 0 0.153" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-2.0944" upper="2.0944" effort="1.6" velocity="6.5"/>
    </joint>
    <xacro:fixed_joint name="laser_joint" parent="lidar_tilt_link" child="laser_link" xyz="0 0 0.022" rpy="0 0 3.14159265"/>

    <xacro:common_link name="camera_link" material="White" path="sensor">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0"/>
            <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/>
        </inertial>
    </xacro:common_link>
    <xacro:fixed_joint name="camera_joint" parent="base_link" child="camera_link" xyz="0.057105 1.7948E-05 0.03755" rpy="0 0 0"/>

    <!-- ==================== OAK-D Lite (2026) ====================
         Mounted at the lidar's previous front location (x=0.0435, z=0.185).
         Frame names follow the depthai_ros convention (camera name "oak").
         Stereo baseline 75 mm: left mono +Y, right mono -Y. -->
    <link name="${ns}/oak-d-base-frame">
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.0611"/>
            <inertia ixx="4.3E-05" ixy="0" ixz="0"
                     iyy="4.5E-06" iyz="0" izz="4.5E-05"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.028 0.091 0.0175"/>
            </geometry>
            <material name="White"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="0.028 0.091 0.0175"/>
            </geometry>
        </collision>
    </link>
    <xacro:fixed_joint name="oak_center_joint" parent="base_link" child="oak-d-base-frame" xyz="0.0435 5.25826986680105E-05 0.185" rpy="0 0 0"/>

    <!-- RGB camera (center) -->
    <link name="${ns}/oak_rgb_camera_frame"/>
    <xacro:fixed_joint name="oak_rgb_camera_joint" parent="oak-d-base-frame" child="oak_rgb_camera_frame" xyz="0 0 0" rpy="0 0 0"/>
    <link name="${ns}/oak_rgb_camera_optical_frame"/>
    <xacro:fixed_joint name="oak_rgb_camera_optical_joint" parent="oak_rgb_camera_frame" child="oak_rgb_camera_optical_frame" xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>

    <!-- Left mono camera (+Y) -->
    <link name="${ns}/oak_left_camera_frame"/>
    <xacro:fixed_joint name="oak_left_camera_joint" parent="oak-d-base-frame" child="oak_left_camera_frame" xyz="0 0.0375 0" rpy="0 0 0"/>
    <link name="${ns}/oak_left_camera_optical_frame"/>
    <xacro:fixed_joint name="oak_left_camera_optical_joint" parent="oak_left_camera_frame" child="oak_left_camera_optical_frame" xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>

    <!-- Right mono camera (-Y) -->
    <link name="${ns}/oak_right_camera_frame"/>
    <xacro:fixed_joint name="oak_right_camera_joint" parent="oak-d-base-frame" child="oak_right_camera_frame" xyz="0 -0.0375 0" rpy="0 0 0"/>
    <link name="${ns}/oak_right_camera_optical_frame"/>
    <xacro:fixed_joint name="oak_right_camera_optical_joint" parent="oak_right_camera_frame" child="oak_right_camera_optical_frame" xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>

    <!-- On-board IMU -->
    <link name="${ns}/oak_imu_frame"/>
    <xacro:fixed_joint name="oak_imu_joint" parent="oak-d-base-frame" child="oak_imu_frame" xyz="0 0 0" rpy="0 0 0"/>

    <!-- ============ Dual VL53L5CX front ToF arrays (2026-09-19) ============
         Source: stls/VL53LCX_mount.STEP. Upper adapter 15 deg, lower 40 deg.
         Meshes are tessellated in CAD part frames, METRES (no 0.001 scale).
         Mount CAD axes: +X robot-left, +Y up, +Z forward.
         Starting attachment uses the old bracket's height/lateral origin.
         Rear mating face moved from CAD z=-24.5 to -21.5 mm, so mount x
         shifts back 3 mm to preserve that face's chassis position.
         Refine ONLY tof_mount_joint for whole-assembly placement in RViz.
         Sensor/adapter relative placements come from the STEP assembly.
         Sensing origin uses the existing package-face point in board CAD:
         (0, 2.45, -1.97) mm. Checked installed 2026-09-22: through this TF the
         lower array's floor returns land at z = -0.011 m, upper's at ~0.
         These are fixed adapter settings, not actuated joints.
         server_x3 publishes /tof/{upper,lower}/points in tof_{upper,lower}_link
         (x out of the cover glass). Legacy tof_link aliases the upper sensor. -->
    <link name="${ns}/tof_mount_link">
        <visual><origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><mesh filename="package://yahboomcar_description/meshes/tof_dual_bracket.stl"/></geometry><material name=""><color rgba="0.75 0.75 0.78 1"/></material>
        </visual>
        <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://yahboomcar_description/meshes/tof_dual_bracket.stl"/></geometry></collision>
        <visual><origin xyz="0.000000000 0.114000000 0.003500000" rpy="0.000000000 -0.000000000 0.000000000"/>
            <geometry><mesh filename="package://yahboomcar_description/meshes/tof_adapter_15.stl"/></geometry><material name=""><color rgba="0.75 0.75 0.78 1"/></material>
        </visual>
        <collision><origin xyz="0.000000000 0.114000000 0.003500000" rpy="0.000000000 -0.000000000 0.000000000"/><geometry><mesh filename="package://yahboomcar_description/meshes/tof_adapter_15.stl"/></geometry></collision>
        <visual><origin xyz="0.000000000 0.020000000 0.003500000" rpy="0.000000000 -0.000000000 0.000000000"/>
            <geometry><mesh filename="package://yahboomcar_description/meshes/tof_adapter_40.stl"/></geometry><material name=""><color rgba="0.75 0.75 0.78 1"/></material>
        </visual>
        <collision><origin xyz="0.000000000 0.020000000 0.003500000" rpy="0.000000000 -0.000000000 0.000000000"/><geometry><mesh filename="package://yahboomcar_description/meshes/tof_adapter_40.stl"/></geometry></collision>
    </link>
    <joint name="${ns}/tof_mount_joint" type="fixed">
        <parent link="${ns}/base_link"/><child link="${ns}/tof_mount_link"/>
        <origin xyz="0.1450 0.0 -0.030549" rpy="1.570796326795 0 1.570796326795"/>
    </joint>
    <link name="${ns}/tof_upper_board_link">
        <visual><origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><mesh filename="package://yahboomcar_description/meshes/tof_breakout.stl"/></geometry><material name=""><color rgba="0.05 0.35 0.12 1"/></material>
        </visual>
        <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://yahboomcar_description/meshes/tof_breakout.stl"/></geometry></collision>
    </link>
    <joint name="${ns}/tof_upper_board_joint" type="fixed">
        <parent link="${ns}/tof_mount_link"/><child link="${ns}/tof_upper_board_link"/>
        <origin xyz="-0.000100000 0.113745168 0.016700834" rpy="-2.879793264 -0.000000000 0.000000000"/>
    </joint>
    <link name="${ns}/tof_upper_link"/>
    <joint name="${ns}/tof_upper_joint" type="fixed">
        <parent link="${ns}/tof_mount_link"/><child link="${ns}/tof_upper_link"/>
        <origin xyz="-0.000100000 0.110868776 0.017969601" rpy="0.000000000 -1.308996939 -1.570796327"/>
    </joint>
    <link name="${ns}/tof_upper_optical_frame"/>
    <joint name="${ns}/tof_upper_optical_joint" type="fixed">
        <parent link="${ns}/tof_upper_link"/><child link="${ns}/tof_upper_optical_frame"/>
        <origin xyz="0 0 0" rpy="-1.570796326795 0 -1.570796326795"/>
    </joint>
    <link name="${ns}/tof_lower_board_link">
        <visual><origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry><mesh filename="package://yahboomcar_description/meshes/tof_breakout.stl"/></geometry><material name=""><color rgba="0.05 0.35 0.12 1"/></material>
        </visual>
        <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://yahboomcar_description/meshes/tof_breakout.stl"/></geometry></collision>
    </link>
    <joint name="${ns}/tof_lower_board_joint" type="fixed">
        <parent link="${ns}/tof_mount_link"/><child link="${ns}/tof_lower_board_link"/>
        <origin xyz="-0.000100000 0.018035352 0.019528620" rpy="-2.443460930 -0.000000000 -0.000000000"/>
    </joint>
    <link name="${ns}/tof_lower_link"/>
    <joint name="${ns}/tof_lower_joint" type="fixed">
        <parent link="${ns}/tof_mount_link"/><child link="${ns}/tof_lower_link"/>
        <origin xyz="-0.000100000 0.014892252 0.019462898" rpy="0.000000000 -0.872664626 -1.570796327"/>
    </joint>
    <link name="${ns}/tof_lower_optical_frame"/>
    <joint name="${ns}/tof_lower_optical_joint" type="fixed">
        <parent link="${ns}/tof_lower_link"/><child link="${ns}/tof_lower_optical_frame"/>
        <origin xyz="0 0 0" rpy="-1.570796326795 0 -1.570796326795"/>
    </joint>
    <link name="${ns}/tof_link"/>
    <joint name="${ns}/tof_joint" type="fixed">
        <parent link="${ns}/tof_upper_link"/><child link="${ns}/tof_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    <link name="${ns}/tof_optical_frame"/>
    <joint name="${ns}/tof_optical_joint" type="fixed">
        <parent link="${ns}/tof_link"/><child link="${ns}/tof_optical_frame"/>
        <origin xyz="0 0 0" rpy="-1.570796326795 0 -1.570796326795"/>
    </joint>
    <!-- ============ PAA5100JE optical flow sensor (2026-09-16) ============
         Downward-looking flow sensor that sits in a cut-out of a modified X3
         Plus bottom plate, held by a printed mount on top of the plate.
         Geometry from stls/paa5100je_assembly3.STEP, whose placements are all
         relative to the plate, so everything below the plate joint is exact
         CAD: mount at plate (-1, 14, 27.5) mm, sensor at (-0.5, 4, 21) mm
         flipped 180 deg about X. The lens face ends up 1 mm below the plate
         underside, i.e. ~26.5 mm above the floor with base_joint 0.0815.

         paa5100je_plate_link is the plate's CAD frame: +X across the robot,
         +Y up (y=0 is the underside), +Z along the robot's +X. Its joint puts
         the underside on the chassis bottom (base_link z=-0.054); the fore/aft
         x and which end faces forward are NOT verified against the robot.
         The plate and mount STLs were converted from STEP in their part
         frames (metres); the sensor STL is the SolidWorks export (mm,
         translated into positive space, undone by its visual origin). -->
    <link name="${ns}/paa5100je_plate_link">
        <inertial>
            <origin xyz="0 0.005 0" rpy="0 0 0"/>
            <mass value="0.150"/>
            <inertia ixx="5.5E-04" ixy="0" ixz="0" iyy="8.8E-04" iyz="0" izz="3.3E-04"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://yahboomcar_description/meshes/X3plus_bottom_plate_modified.STL"/>
            </geometry>
            <material name="White"/>
        </visual>
        <visual>
            <origin xyz="-0.001 0.014 0.0275" rpy="1.5707963 0 0"/>
            <geometry>
                <mesh filename="package://yahboomcar_description/meshes/paa5100je_left_centered_mount.STL"/>
            </geometry>
            <material name="White"/>
        </visual>
        <visual>
            <origin xyz="-0.0125 0.004 0.033" rpy="3.1415927 0 0"/>
            <geometry>
                <mesh filename="package://yahboomcar_description/meshes/PAA5100JE_sensor.STL" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="Green"/>
        </visual>
    </link>
    <xacro:fixed_joint name="paa5100je_plate_joint" parent="base_link" child="paa5100je_plate_link" xyz="-0.0344 0.0 -0.054" rpy="1.5707963 0 1.5707963"/>

    <!-- Sensing frame at the centre of the lens face, axes aligned with
         base_link (+X forward, +Z up; the lens looks -Z). Its z in
         base_footprint is the sensor's height above the floor. -->
    <link name="${ns}/paa5100je_link"/>
    <xacro:fixed_joint name="paa5100je_joint" parent="paa5100je_plate_link" child="paa5100je_link" xyz="-0.0005 -0.001 0.021" rpy="-1.5707963 -1.5707963 0"/>
</robot>
