<?xml version="1.0"?>
<!--
  yahboomcar_X3_gazebo.urdf.xacro
  Extends yahboomcar_X3.urdf with Ignition Fortress (gz-sim 6) plugins:
    - ignition::gazebo::systems::VelocityControl  → /cmd_vel (holonomic)
    - ignition::gazebo::systems::Sensors          → laser (world-level system)
    - ignition::gazebo::systems::Imu              → IMU   (world-level system)

  Topics bridged to ROS 2 via ros_gz_bridge in x3_gazebo.launch.py:
    /lidar    (gz) → /scan      (ROS sensor_msgs/LaserScan)
    /imu_raw  (gz) → /imu/data  (ROS sensor_msgs/Imu)
    /cmd_vel  (ROS) → VelocityControl plugin (holonomic: linear.x/y + angular.z)
-->
<robot name="yahboomcar" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Base robot structure (joints, links, meshes, inertia) -->
  <xacro:include filename="$(find yahboomcar_description)/urdf/yahboomcar_X3.urdf"/>

  <!-- ── Holonomic drive via VelocityControl ──────────────────────────────
       VelocityControl applies cmd_vel directly as body-frame velocity to the
       model, preserving linear.x, linear.y, angular.z — full holonomic motion.
       This matches the behaviour of the old libgazebo_ros_planar_move.so.
       Note: Fortress VelocityControl listens on /model/<name>/cmd_vel by
       default inside Ignition Transport; the ros_gz_bridge maps /cmd_vel
       (ROS) to that topic.                                                  -->
  <gazebo>
    <plugin filename="ignition-gazebo-velocity-control-system"
            name="ignition::gazebo::systems::VelocityControl">
      <!-- Explicitly set to /cmd_vel so it matches what ros_gz_bridge publishes. -->
      <!-- Without this, the plugin defaults to /model/yahboomcar_x3/cmd_vel     -->
      <!-- which is a different Ignition Transport topic — robot won't move.      -->
      <topic>/cmd_vel</topic>
      <initial_linear>0 0 0</initial_linear>
      <initial_angular>0 0 0</initial_angular>
    </plugin>
  </gazebo>

  <!-- ── 2-D lidar (mirrors YDLidar X3 TOF: 360°, 8 Hz, 8 m max) ─────────
       In Fortress, no child <plugin> is needed inside <sensor>.
       The world-level ignition::gazebo::systems::Sensors drives all sensors.
       The <topic> tag sets the Ignition Transport topic name.               -->
  <gazebo reference="laser_link">
    <sensor name="laser" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>8</update_rate>
      <topic>/lidar</topic>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
    </sensor>
  </gazebo>

  <!-- ── IMU ──────────────────────────────────────────────────────────────
       Driven by world-level ignition::gazebo::systems::Imu system.          -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/imu_raw</topic>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.009</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.021</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>


  <!-- ── Depth Camera (mirrors Orbbec Astra Pro depth: 640x480, 10 Hz) ────
       type="depth_camera" outputs a 32FC1 float image (metres per pixel).
       Driven by world-level Sensors system alongside the RGB camera.
       ros_gz_bridge maps /camera/depth_image → ROS sensor_msgs/Image
       (encoding 32FC1); ROS2Bridge.get_depth_frame() colormaps it to BGR. -->
  <gazebo reference="camera_link">
    <sensor name="depth_camera" type="depth_camera">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <topic>/camera/depth_image</topic>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.05</near>
          <far>4.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- ── RGB Camera (mirrors Orbbec Astra Pro: 640x480, 20 Hz) ────────────
       Driven by world-level ignition::gazebo::systems::Sensors (ogre2).
       The <topic> sets the Ignition Transport topic name; ros_gz_bridge
       maps it to ROS /camera/image_raw (sensor_msgs/Image).             -->
  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>20</update_rate>
      <topic>/camera/image_raw</topic>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>RGB_INT8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>10.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

</robot>
