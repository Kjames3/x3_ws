[Unit]
Description=Yahboom X3 WebSocket Control Server
After=network.target
Wants=network.target

[Service]
Type=simple
User=jetson
Group=jetson
SupplementaryGroups=plugdev

WorkingDirectory=/home/jetson/x3_ws/src

# ── Launch mode ────────────────────────────────────────────────────────────────
# Default: ROS2 hardware bridge mode (launches x3_bringup, subscribes /scan + /cmd_vel)
#
# ROS2 Humble is sourced explicitly here because systemd does NOT read ~/.bashrc.
# The workspace local_setup is sourced with || true so the service still starts
# if the workspace hasn't been built yet (ROS2 base will still be available).
ExecStart=/bin/bash -c '\
  source /opt/ros/humble/setup.bash && \
  source /home/jetson/x3_ws/install/local_setup.bash 2>/dev/null || true && \
  JETSON_IP="" && \
  for ip in $(hostname -I); do \
    if [[ ! "$ip" =~ ^172\. ]]; then \
      JETSON_IP="$ip" && \
      break; \
    fi; \
  done && \
  if [ -n "$JETSON_IP" ]; then \
    export ROS_DISCOVERY_SERVER="TCPv4:[$JETSON_IP]:11811"; \
  else \
    export ROS_DISCOVERY_SERVER="TCPv4:[127.0.0.1]:11811"; \
  fi && \
  export FASTDDS_BUILTIN_TRANSPORTS=LARGE_DATA && \
  exec python3 /home/jetson/x3_ws/src/server_x3.py $SERVER_ARGS'

# To switch modes without editing this file, override SERVER_ARGS in
#   /etc/systemd/system/x3_server.service.d/override.conf
#
# Simulation / no hardware:
#   Environment=SERVER_ARGS=--sim
#
# Apply with:  sudo systemctl daemon-reload && sudo systemctl restart x3_server

Environment="SERVER_ARGS=--domain-id 42"
Environment=ROS_DOMAIN_ID=42
# Point all ROS2 nodes to the local FastDDS discovery server instead of multicast.
# This is required on school/enterprise WiFi which blocks UDP multicast and
# client-to-client UDP.  The discovery server runs as fastdds_discovery.service.
Environment="ROS_DISCOVERY_SERVER=TCPv4:[127.0.0.1]:11811"
Environment="FASTDDS_BUILTIN_TRANSPORTS=LARGE_DATA"
# ──────────────────────────────────────────────────────────────────────────────

Restart=on-failure
RestartSec=5

# Give hardware (serial, I2C, USB) time to enumerate after boot
# Orbbec camera and Rosmaster can take 10+ seconds on a cold boot
ExecStartPre=/bin/sleep 10

# Environment
Environment=PYTHONUNBUFFERED=1

# Logging — view with: journalctl -u x3_server -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=x3_server

[Install]
WantedBy=multi-user.target
