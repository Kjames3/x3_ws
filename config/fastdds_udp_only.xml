<?xml version="1.0" encoding="utf-8" ?>
<!--
  fastdds_udp_only.xml - FastDDS participant profile that turns shared memory OFF.

  Used for the Mcnamu driver node only (x3_bringup.launch.py sets
  FASTRTPS_DEFAULT_PROFILES_FILE for that one process; Humble's Fast-DDS 2.6 reads
  the FASTRTPS_ name, not FASTDDS_).  With the default transports every participant
  on the host talks over a shared-memory port; on 2026-10-22 the driver's counters
  (/driver_diag) showed it receiving NOTHING on /cmd_vel for ~4 s while its executor
  was healthy and an independent subscriber on the same topic kept receiving.
  Same-host UDP loopback avoids that path.  Turn off with X3_DRIVER_UDP_ONLY=0.
-->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>
    <transport_descriptors>
      <transport_descriptor>
        <transport_id>udp_only</transport_id>
        <type>UDPv4</type>
      </transport_descriptor>
    </transport_descriptors>
    <participant profile_name="driver_udp_only" is_default_profile="true">
      <rtps>
        <useBuiltinTransports>false</useBuiltinTransports>
        <userTransports>
          <transport_id>udp_only</transport_id>
        </userTransports>
      </rtps>
    </participant>
  </profiles>
</dds>
