# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.env/
.venv/
.pytest_cache/

# ROS2 colcon build artifacts — never commit these
build/
install/
log/
*.egg-info/

# IDE / OS
.vscode/
.idea/
*.swp
.DS_Store

# Ignore folder
archive/

# Cache directories and cache files
.cache/
*.cache
# Claude Code local state: worktrees are full nested checkouts, and
# settings.local.json is per-machine. The skills/ dir is tracked.
.claude/worktrees/
.claude/settings.local.json

# Editor-snapshot debris.  Both machines accumulate these from patch-and-verify
# work; the real version is always the committed one.
*.bak
*.bak-*
*.bak.*
.bak_*/
*.orig

# Runtime output, not source.
logs/
local_llm_runs/

# Obsidian vault state: the repo root IS the vault, but this dir is per-machine
# plugin data and editor layout.  The notes themselves are tracked as *.md.
.obsidian/

# Robot-local runtime and bulky artifacts.  Kept on the Jetson, out of git:
# battery_state.json is live SoC state, the TensorRT engine is rebuilt per
# machine and JetPack version, and webrtc_poc/ carries a 60 MB mediamtx binary
# and a self-signed key pair.
config/battery_state.json
.rosmaster_backup_*/
*.engine
src/yolo_models/default/yolo26n.onnx
src/yolo_models/default/bus.jpg
src/webrtc_poc/mediamtx
src/webrtc_poc/auto.crt
src/webrtc_poc/auto.key

# Octomap .bt files are sweep output, regenerated by a 3D scan.
*.bt

# Raw capture point clouds from hardware validation runs (tens of MB each).
# The .json/.log/.py summaries beside them ARE tracked, so results stay
# reproducible; the raw returns live on the laptop and the robot.
# Exceptions, both small and load-bearing: sign_comparison.npz is the cited
# tilt_direction evidence (CLAUDE.md, notes/), and drive_capture.npz is the
# only multi-pose capture -- every real-data result in
# notes/registration_feasibility.md, including the pose graph, derives from it
# and cannot be reproduced without it.
artifacts/**/*.npz
!artifacts/deskew-2026-09-04/sign_comparison.npz
!artifacts/registration-2026-09-05/drive_capture.npz
