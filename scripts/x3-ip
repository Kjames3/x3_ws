#!/usr/bin/env bash
# x3-ip — Print the robot's current address. The one command that replaces
#         squinting at the OLED screen.
#
# Usage:
#   x3-ip                 print the resolved address (exit 1 if unresolvable)
#   x3-ip get             same
#   x3-ip set <IP>        probe <IP>, then remember it (run this instead of
#                         pasting an IP into a prompt)
#   x3-ip status          cached address, its age, how it resolved, reachability
#   x3-ip clear           forget the cached address
#
# `get` prints the bare address and nothing else, so it composes:
#   ssh jetson@"$(x3-ip)"
#   scp file jetson@"$(x3-ip)":~/
#
# Resolution order and knobs live in robot_env.sh; see its header.
# =============================================================================

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
X3_CACHE="${X3_CACHE:-$HOME/.x3_robot}"

usage() { sed -n '2,20p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

cmd_get() {
    # robot_env.sh exits non-zero and explains itself on failure; pass that on.
    # shellcheck source=scripts/robot_env.sh
    source "$SCRIPT_DIR/robot_env.sh" || return 1
    echo "$ROBOT_IP"
}

cmd_set() {
    local ip="${1:-}"
    if [ -z "$ip" ]; then
        echo "usage: x3-ip set <IP>" >&2
        return 2
    fi
    # Probe before caching. Caching an address that does not answer would just
    # move the failure to the next command, where it is harder to read.
    if ! nc -z -w"${X3_PROBE_TIMEOUT:-2}" "$ip" 22 >/dev/null 2>&1; then
        echo "  [x3-ip] $ip is not answering on port 22." >&2
        echo "          Cached anyway; re-run 'x3-ip status' once the robot is up." >&2
        printf 'ip=%s\nvia=manual\nupdated=%s\n' "$ip" "$(date -Iseconds)" > "$X3_CACHE"
        return 1
    fi
    printf 'ip=%s\nvia=manual\nupdated=%s\n' "$ip" "$(date -Iseconds)" > "$X3_CACHE"
    echo "  [x3-ip] robot is $ip — cached in $X3_CACHE"
}

cmd_status() {
    if [ ! -r "$X3_CACHE" ]; then
        echo "  cache:     (none at $X3_CACHE)"
    else
        local ip via updated
        ip=$(sed -n 's/^ip=//p' "$X3_CACHE" | head -n1)
        via=$(sed -n 's/^via=//p' "$X3_CACHE" | head -n1)
        updated=$(sed -n 's/^updated=//p' "$X3_CACHE" | head -n1)
        echo "  cache:     ${ip:-?}  (via ${via:-?}, updated ${updated:-?})"
        if nc -z -w2 "$ip" 22 >/dev/null 2>&1; then
            echo "  reachable: yes (port 22 open)"
        else
            echo "  reachable: NO"
        fi
    fi

    if command -v tailscale >/dev/null 2>&1; then
        local ts
        ts=$(tailscale ip -4 "${X3_TS_HOST:-x3}" 2>/dev/null | head -n1)
        echo "  tailscale: ${ts:-not resolving \"${X3_TS_HOST:-x3}\"}"
    else
        echo "  tailscale: not installed"
    fi

    local lan
    lan=$(getent hosts "${X3_LAN_HOST:-x3.lan}" 2>/dev/null | awk '{print $1}' | head -n1)
    echo "  router dns: ${lan:-\"${X3_LAN_HOST:-x3.lan}\" does not resolve}"

    echo
    echo "  resolving now..."
    X3_VERBOSE=1 cmd_get >/dev/null || true
}

cmd_clear() {
    rm -f "$X3_CACHE"
    echo "  [x3-ip] cleared $X3_CACHE"
}

case "${1:-get}" in
    get|"")      cmd_get ;;
    set)         shift; cmd_set "$@" ;;
    status)      cmd_status ;;
    clear)       cmd_clear ;;
    -h|--help)   usage ;;
    *)           echo "x3-ip: unknown command '$1'" >&2; usage >&2; exit 2 ;;
esac
